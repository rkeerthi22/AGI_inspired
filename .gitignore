# Secrets — never commit
.env
*.key
secrets/

# Live binaries — backed up separately (nightly, orchestrator/backup.py + AGI_M1_backup
# schtask; see docs/HARDENING.md H9/F16), not version-controlled
ledger/*.db
ledger/*.db-shm
ledger/*.db-wal
memory/*.db
memory/*.db-shm
memory/*.db-wal
prediction_machine/data/*.db
prediction_machine/data/*.db-shm
prediction_machine/data/*.db-wal
backups/

# Agent scratch + ingested raw data (audit lives in the ledger, not here).
# Track the folder READMEs so the layout survives a clone; ignore everything else.
workspace/*
!workspace/README.md
# The validation cohort runner is maintained harness code, not scratch output.
# Keep its sibling summaries/artifacts ignored.
!workspace/validation/
workspace/validation/*
!workspace/validation/run_cohort.py
!workspace/validation/cohort_isolation.py
!workspace/validation/cohort_missions.json
!workspace/validation/byteplus_connectivity_canary.py
!workspace/validation/cohort_baseline_manifest.json
!workspace/validation/cohort_prompt_template.txt
_needs_review/
inbox/*
!inbox/README.md
runs/
*.log

# Operator-supplied reference material for the assistant (created 2026-07-29): a live-verified
# write-up of the local harness/Hermes/Ollama architecture. Reference, not a project artifact —
# untracked so it never enters the audit trail, and named explicitly rather than by pattern so
# a future root-level file is still surfaced by the F42 root guard instead of silently hidden.
extensive_research.md

# Python
__pycache__/
*.pyc
.venv/

